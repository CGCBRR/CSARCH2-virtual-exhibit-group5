---
// src/layouts/BaseLayout.astro
export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Ca-Ching! — CPU Cache Visualizer",
  description = "An interactive educational dashboard simulating how a CPU fetches data from Cache vs. Main Memory"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    
    <style is:global>
      @import "../styles/globals.css";
    </style>
  </head>
  <body class="font-sans antialiased bg-slate-950 text-slate-100 selection:bg-cyan-500/30">
    <slot />
  </body>
</html>